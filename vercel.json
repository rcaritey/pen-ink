{
  "functions": {
    "api/suggest.js": {
      "maxDuration": 120
    }
  },
  "routes": [
    {
      "src": "/(.*)",
      "headers": {
        "X-Content-Type-Options": "nosniff",
        "Referrer-Policy": "strict-origin-when-cross-origin",
        "X-Frame-Options": "DENY",
        "Permissions-Policy": "microphone=(self), camera=(), geolocation=()",
        "Strict-Transport-Security": "max-age=31536000; includeSubDomains"
      },
      "continue": true
    },
    {
      "src": "/prep/?",
      "has": [
        {
          "type": "host",
          "value": "^(www\\.)?(presentcare\\.ca|presentsante\\.ca|presentsante\\.com)$"
        }
      ],
      "status": 307,
      "headers": {
        "Location": "/try"
      }
    },
    {
      "src": "/",
      "has": [
        {
          "type": "host",
          "value": "^(www\\.)?(presentcare\\.ca|presentsante\\.ca|presentsante\\.com)$"
        }
      ],
      "dest": "/presentcare/index.html"
    },
    {
      "src": "/try/?",
      "has": [
        {
          "type": "host",
          "value": "^(www\\.)?(presentcare\\.ca|presentsante\\.ca|presentsante\\.com)$"
        }
      ],
      "dest": "/prep/index.html"
    },
    {
      "handle": "filesystem"
    }
  ]
}
